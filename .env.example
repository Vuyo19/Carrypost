# CarrypostBackend (FastAPI), proxied under this app's own origin at /api/*
# (see the rewrite in next.config.ts). Kept relative and same-origin
# deliberately: Carrypost's session is an httpOnly cookie set by the
# backend's OAuth callback, and a cookie set for one origin is never sent to
# a different one — two separate hosts (or even two different
# *.trycloudflare.com subdomains) would silently break the session. The
# OAuth buttons on /sign-up and /log-in navigate here directly (not via
# fetch) — the flow leaves the app entirely for Google/Microsoft/Apple and
# comes back via a redirect that sets the cookie, landing back at /home.
NEXT_PUBLIC_API_URL=/api/v1

# Where next.config.ts's rewrite actually forwards /api/* to. Only needs
# changing if the backend isn't running on the default local port.
# API_PROXY_TARGET=http://127.0.0.1:8000

# RevenueCat Web Billing SDK (@revenuecat/purchases-js) — see
# lib/revenuecat.ts. This is the PUBLIC SDK key (safe to ship to the
# browser, same category as a Stripe publishable key), not a secret.
NEXT_PUBLIC_REVENUECAT_API_KEY=

# The entitlement identifier configured in the RevenueCat dashboard that
# "Carrypost Ultra" membership grants. Everything that checks membership
# status gates on this one identifier — must match the mobile app's
# CarrypostMobile/.env.example value for the two platforms to agree.
NEXT_PUBLIC_REVENUECAT_ENTITLEMENT_ID=carrypost_pro
