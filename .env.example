# CarrypostBackend (FastAPI). The OAuth buttons on /sign-up and /log-in
# navigate the browser here directly (not via fetch) — the flow leaves the
# app entirely for Google/Microsoft/Apple and comes back via a redirect that
# sets Carrypost's session cookie, then lands back on this app at /home.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
